# Supabase Edge runtime (SUPABASE_URL is injected in hosted functions)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:4173,http://127.0.0.1:5173

# Provider
# Supported values: mock, fal
AI_PROVIDER=mock
FAL_KEY=
MOCK_AI_DELAY_MS=500
MOCK_AI_FAILURE_MODE=none
MOCK_AI_WEBHOOK_SECRET=local-development-secret

# Upload and retention limits
IMAGE_MAX_BYTES=26214400
IMAGE_MAX_WIDTH=8192
IMAGE_MAX_HEIGHT=8192
VIDEO_MAX_BYTES=524288000
VIDEO_MAX_DURATION_MS=60000
VIDEO_MAX_WIDTH=1920
VIDEO_MAX_HEIGHT=1080
SIGNED_UPLOAD_TTL_SECONDS=900
SIGNED_DOWNLOAD_TTL_SECONDS=300
SESSION_TTL_HOURS=72
MAX_REQUEST_BYTES=1048576
JOB_MAX_ATTEMPTS=3
JOB_RATE_LIMIT_PER_MINUTE=20

# Internal scheduled-function authentication
INTERNAL_CRON_SECRET=replace-with-a-long-random-value
